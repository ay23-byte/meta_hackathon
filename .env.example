# LabLens AI environment configuration
# Copy this file to `.env` in the project root and fill in your own secret.
# Never commit `.env` or share your real API key.

# Required for optional Muse Spark interpretation via Baseten.
# Leave unset to use the app fully offline (calculations, plots, exports,
# agent audit trails and the explicitly labelled deterministic OFFLINE MOCK
# report). A key being present does NOT prove live reachability or quota:
# the sidebar "Provider status" reports live_verified=false until a real
# request succeeds. Obvious placeholders such as the value below are treated
# as NOT configured. Process environment variables always win over this file;
# `provider_config.py` reads it with dotenv_values and never mutates os.environ.
# The bounded analysis agent also works offline: with no key it uses a
# deterministic fallback planner. With a key, use --use-ai / --agent-use-ai or
# the "Let Muse Spark propose the plan" checkbox to request an AI plan.
# Never paste a real key into chat, code or commits.
BASETEN_API_KEY=your_baseten_api_key_here

# Optional model override. The default is the identifier published by Meta
# and Baseten: meta-models/muse-spark-open. Some hackathon accounts are
# assigned a dated variant; set it here only if your provider instructs you to.
# BASETEN_MODEL=

# Optional report completion budget (includes reasoning and visible output).
# Default 4096; allowed range 1024-16384. Larger values can cost more and
# do not guarantee a final answer. Increase only after an explicit decision.
# LABLENS_REPORT_MAX_TOKENS=8192

# Optional, separate hosted model. These lines are documentation ONLY:
# the hosted adapter reads PROCESS ENVIRONMENT VARIABLES, not this .env file.
# Set them privately after confirming the provider's endpoint and credit terms.
# No endpoint is supplied and no paid fallback is configured.
# LABLENS_AI_PROVIDER=hosted
# LABLENS_MODEL=meta-models/Muse-Glimmer-30B
# LABLENS_API_KEY=<set-privately-in-process-environment>
# LABLENS_BASE_URL=<confirmed-https-openai-compatible-base-url>
# LABLENS_MAX_OUTPUT_TOKENS=2048
# LABLENS_TIMEOUT_SECONDS=60
